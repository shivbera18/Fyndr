# ==============================================================================
# FYNDR — TOP-LEVEL PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# Region Pre-Configured: India West (Mumbai) [ap-mumbai-1]
# ==============================================================================
#
# Instructions:
# 1. On your Oracle Cloud VM, copy the backend sections into `node-server-1/.env`
#    and ML sections into `flask-server-2/.env`.
# 2. On Vercel Dashboard, paste the FRONTEND section under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS BACKEND API (node-server-1/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Connection String (127.0.0.1 for local mongod on VM)
MONGO_URI=mongodb://127.0.0.1:27017/photo_sharing_db

# JWT Secret Key (Generate a strong random 64-character string)
# e.g., run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace_with_a_secure_random_jwt_secret_64_characters_long

# Internal Python Flask ML Service URL (bound locally on VM)
FLASK_URL=http://127.0.0.1:5001

# Allowed CORS Origins (set to '*' or your Vercel frontend URL, e.g. https://fyndr.vercel.app)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. EMAIL VERIFICATION SERVICE (Gmail App Password or SMTP)
# ------------------------------------------------------------------------------
# Used for sending photographer email verification links
EMAIL_USER=your_email@gmail.com
# Use an App Password (not your personal Gmail login password):
EMAIL_PASS=your_16_character_gmail_app_password

# ------------------------------------------------------------------------------
# 3. ORACLE CLOUD (OCI) OBJECT STORAGE (S3-Compatible API)
# Region: India West (Mumbai) -> ap-mumbai-1
# ------------------------------------------------------------------------------
# Replace <your_tenancy_namespace> with your OCI Tenancy Namespace (e.g., ax9k1pq8z)
# Found under: OCI Console -> Top-right Profile icon -> Tenancy: <your-name> -> Object Storage Namespace
R2_ENDPOINT=https://<your_tenancy_namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com

# Customer Secret Keys (Generated in OCI Console -> Identity -> Users -> Customer Secret Keys)
# Access Key is the alphanumeric key shown in the Customer Secret Keys table
R2_ACCESS_KEY=your_customer_access_key_id_here

# Secret Key is the generated secret token (only displayed once during key creation)
R2_SECRET_KEY=your_customer_secret_key_token_here

# The name of your OCI Object Storage bucket (Storage -> Buckets)
R2_BUCKET=fyndr-photos

# OCI Region identifier
R2_REGION=ap-mumbai-1

# ------------------------------------------------------------------------------
# 4. PYTHON FLASK ML SERVICE (flask-server-2/.env)
# ------------------------------------------------------------------------------
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/photo_sharing_db
FAISS_BASE=/tmp/fyndr_faiss

# ------------------------------------------------------------------------------
# 5. VERCEL FRONTEND (Configure in Vercel Dashboard -> Environment Variables)
# ------------------------------------------------------------------------------
# Set this to your Oracle Cloud Server domain or public IP:
# e.g., https://api.yourdomain.com or http://<YOUR_ORACLE_PUBLIC_IP>
REACT_APP_API_URL=https://api.yourdomain.com
