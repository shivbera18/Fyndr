# 32 random bytes, base64 (`openssl rand -base64 32`); encrypts photographer refresh tokens
DRIVE_TOKEN_KEY=

# S3-compatible object store (G3 on VPS). Unset = local-disk fallback.
# R2_ENDPOINT=http://127.0.0.1:9000
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=fyndr-photos
# R2_REGION=auto
# Public browser origin of the same store for direct browser-to-G3 upload (via Nginx reverse proxy).
# When using G3 on VPS: R2_PUBLIC_ENDPOINT=https://129.151.47.214.sslip.io (proxied to :9000 by Nginx)
# Empty/unset disables direct upload and falls back to multer.
R2_PUBLIC_ENDPOINT=https://129.151.47.214.sslip.io